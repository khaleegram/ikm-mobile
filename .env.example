# ChatCart Mobile App — public vars only (safe in client)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Hybrid feed API (Cloud Run): https://chatcart-api-PROJECT_NUMBER.us-central1.run.app/v1
EXPO_PUBLIC_API_BASE_URL=https://chatcart-api-723822682554.us-central1.run.app/v1

# Legacy Firebase Cloud Functions host (admin/payments/products/etc — see lib/api/cloud-functions-base.ts).
# Only needed if the Cloud Run project/region ever changes; safe to leave unset otherwise.
# EXPO_PUBLIC_CLOUD_RUN_HOST_SUFFIX=q3rjv54uka-uc.a.run.app
# EXPO_PUBLIC_LEGACY_FUNCTIONS_REGION=us-central1
# EXPO_PUBLIC_LEGACY_FUNCTIONS_PROJECT_ID=ikm-marketplace

# Cloudflare R2 CDN for media delivery
EXPO_PUBLIC_MEDIA_CDN_URL=https://media.chatcart.shop

EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=

EXPO_PUBLIC_APP_VARIANT=market

# Market chat is always Postgres (chatcart-api Deal Threads). No client flag.
# Market order reads are always Postgres. Order writes: CF → Firestore + Neon dual-write.
