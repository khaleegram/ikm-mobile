# ChatCart Mobile App — public vars only (safe in client)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Hybrid feed API (Cloud Run): https://chatcart-api-PROJECT_NUMBER.us-central1.run.app/v1
EXPO_PUBLIC_API_BASE_URL=https://chatcart-api-723822682554.us-central1.run.app/v1

# Cloudflare R2 CDN for media delivery
EXPO_PUBLIC_MEDIA_CDN_URL=https://media.chatcart.shop

EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=

EXPO_PUBLIC_APP_VARIANT=market

# Chat backend: postgres (chatcart-api Deal Threads). Legacy firestore is unsupported for market.
EXPO_PUBLIC_CHAT_BACKEND=postgres
