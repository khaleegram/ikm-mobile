# ChatCart API — Version One (Hybrid: Neon + Upstash + Cloud Run)
# Full AWS spec: docs/chatcart-aws-migration.md (future)
# Active spec: docs/chatcart-hybrid-migration.md

NODE_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080
CORS_ORIGINS=*

# Neon PostgreSQL (feed state only)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/chatcart?sslmode=require

# Upstash Redis — create ONE database in console (free tier is fine)
# Dashboard shows REST creds (use these with @upstash/redis):
UPSTASH_REDIS_REST_URL=https://YOUR-ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token
# Optional alternative for ioredis (Connect tab → Redis URL):
# REDIS_URL=rediss://default:token@YOUR-ENDPOINT.upstash.io:6379

# Firebase — auth verify + Firestore hydrate reads
FIREBASE_PROJECT_ID=ikm-marketplace
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json

# Feed
FEED_CACHE_TTL_SEC=600
FEED_PAGE_SIZE=25

# Cloudflare R2 media (required for uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chatcart-media-prod
MEDIA_CDN_URL=https://media.chatcart.shop
MEDIA_PRESIGN_TTL_SEC=3600

# Shared secret for order system events → chat threads (Cloud Functions)
CHAT_INTERNAL_SECRET=

# ── Calls (voice / video) ────────────────────────────────────────────────────
# TURN relays call audio and video when the two phones cannot reach each other directly, which is
# most mobile networks. Without it calls ring, connect, then drop. Cloudflare Realtime TURN is used
# because the media bucket is already on Cloudflare: Dashboard → Realtime → TURN Keys.
# Leave these unset and calls fall back to STUN only (works on the same wifi, not on mobile data).
TURN_KEY_ID=
TURN_API_TOKEN=
TURN_TTL_SEC=3600

# Optional self-hosted coturn, used alongside or instead of the hosted provider.
# Comma-separated, e.g. turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# One-time migration script only
FIREBASE_STORAGE_BUCKET=ikm-marketplace.firebasestorage.app
